# Copy to your own config, replace model/tokens, and chmod 600 the file.
# Use --workspace /absolute/path to keep production state outside the sources.
security:
  profile: daemon
models:
  default_model: YOUR_MODEL_ID
  providers:
    - name: openai
      api_key_env: OPENAI_API_KEY
      models: [YOUR_MODEL_ID]
      # For compatible endpoints include their required API prefix:
      # api_base: https://your-model-service.example/v1
gateway:
  host: 127.0.0.1
  port: 58123
  auth:
    mode: allowlist
    api_tokens: [REPLACE_WITH_RANDOM_API_TOKEN]
    admin_tokens: [REPLACE_WITH_DIFFERENT_RANDOM_ADMIN_TOKEN]
    allowed_users: ["api:operator", "cli:local", "ws:local"]
tools:
  profile: coding
  restrict_to_workspace: true
  # coding includes cronjob (approval still required). Enable the scheduler and
  # opt in to the web/skill tools used by unattended research jobs.
  # skill_run still requires execution/dependency approval. Shell stays blocked.
  # An exclusive tools.allow list must include these names itself; deny wins.
  also_allow: [web_fetch, skill_run, cronjob]
scheduler:
  enabled: true
