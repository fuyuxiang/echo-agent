/* echo_agent/cli/tui/app.tcss — three-zone layout: transcript fills, input
   row docks with auto height and divider lines, status bar pinned to bottom. */
TranscriptView {
    height: 1fr;
}

/* Brand banner on the first screen: a rounded panel with breathing room. */
Banner {
    margin: 1 1 0 1;
    padding: 0 1;
    border: round $primary;
    color: $text;
}

/* User task title: a left accent bar + a full-row tinted background + blank
   lines above/below, so each submitted task stands out and reads as a clear
   divider between turns. $primary-muted (not the near-invisible $boost) fills
   the whole row in the brand hue, matching the accent bar and the ● reply
   sigil; it is a theme variable so it adapts to light/dark automatically. */
UserTurn {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $accent;
    background: $primary-muted;
    color: $text;
}

/* Reply and trace blocks: gentle left indent + a little vertical rhythm, so
   each turn's reply/tool/thinking lines group cleanly under the task title
   without heavy borders competing with UserTurn. */
AgentReply {
    padding: 0 1;
    margin: 0 0 1 0;
}

/* Tool/cognitive trace lines are interactive: click or focus + Enter/Space
   toggles their detail/diff view. A hover + focus cue makes that discoverable
   (they were previously togglable in code but had no input path). */
ToolCallBlock, CognitiveBlock {
    padding: 0 1;
}

ToolCallBlock:hover, CognitiveBlock:hover {
    background: $boost;
}

ToolCallBlock:focus, CognitiveBlock:focus {
    background: $boost;
    border-left: thick $accent;
    padding-left: 0;
}

ApprovalBlock {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $warning;
    background: $boost;
}

ChoiceBlock {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $secondary;
    background: $boost;
}

#input_row {
    height: auto;
    max-height: 10;
    min-height: 1;
    border-top: solid $primary;
    border-bottom: solid $primary;
    layers: base hint;
}

#prompt_sigil {
    width: 2;
    color: $accent;
    text-style: bold;
}

PromptInput {
    height: auto;
    border: none;
}

/* Disabled while a clarify/approval owns the keyboard: dim it so the user
   sees the prompt is inert and their number/arrow/y-n-a keys drive the
   pending prompt instead. textual does not dim disabled widgets on its own. */
PromptInput:disabled {
    color: $text-muted;
    text-opacity: 60%;
}

/* Placeholder overlays the input area (hint layer) instead of taking its own
   row, so the empty state no longer shows a stray caption line under the box.
   It is hidden on first keystroke (display toggled by ContentChanged). */
#placeholder {
    layer: hint;
    offset: 3 0;
    width: 1fr;
    height: 1;
    color: $text-muted;
}

StatusBar {
    height: 1;
    dock: bottom;
    background: $surface;
    color: $text;
}

#slash_panel {
    height: auto;
    max-height: 6;
    border: round $primary;
}
