/* echo_agent/cli/tui/app.tcss — three-zone layout: transcript fills, input
   row docks with auto height and divider lines, status bar pinned to bottom. */
TranscriptView {
    height: 1fr;
}

/* Brand banner on the first screen: a rounded panel with breathing room. */
Banner {
    margin: 1 1 0 1;
    padding: 0 1;
    border: round $primary;
    color: $text;
}

/* User task title: a left accent bar + subtle boost background + blank lines
   above/below, so each submitted task stands out and reads as a clear divider
   between turns. Colors use theme variables so they adapt to light/dark. */
UserTurn {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $accent;
    background: $boost;
    color: $text;
}

/* Reply and trace blocks: gentle left indent + a little vertical rhythm, so
   each turn's reply/tool/thinking lines group cleanly under the task title
   without heavy borders competing with UserTurn. */
AgentReply {
    padding: 0 1;
    margin: 0 0 1 0;
}

ToolCallBlock, CognitiveBlock {
    padding: 0 1;
}

ApprovalBlock {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $warning;
    background: $boost;
}

ChoiceBlock {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $secondary;
    background: $boost;
}

#input_row {
    height: auto;
    max-height: 10;
    min-height: 1;
    border-top: solid $primary;
    border-bottom: solid $primary;
}

#prompt_sigil {
    width: 2;
    color: $accent;
    text-style: bold;
}

PromptInput {
    height: auto;
    border: none;
}

#placeholder {
    height: 1;
    color: $text-muted;
    padding-left: 2;
}

StatusBar {
    height: 1;
    dock: bottom;
    background: $surface;
    color: $text;
}

#slash_panel {
    height: auto;
    max-height: 6;
    border: round $primary;
}
