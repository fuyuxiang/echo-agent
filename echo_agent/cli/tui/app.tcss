/* echo_agent/cli/tui/app.tcss — three-zone layout: transcript fills, input
   row docks with auto height and divider lines, status bar pinned to bottom. */
TranscriptView {
    height: 1fr;
}

/* User task title: a left accent bar + subtle boost background + blank lines
   above/below, so each submitted task stands out and reads as a clear divider
   between turns. Colors use theme variables so they adapt to light/dark. */
UserTurn {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $accent;
    background: $boost;
    color: $text;
}

#input_row {
    height: auto;
    max-height: 10;
    min-height: 1;
    border-top: solid grey;
    border-bottom: solid grey;
}

#prompt_sigil {
    width: 2;
    color: $accent;
}

PromptInput {
    height: auto;
    border: none;
}

#placeholder {
    height: 1;
    color: grey;
    padding-left: 2;
}

StatusBar {
    height: 1;
    dock: bottom;
    background: $surface;
    color: $text;
}

#slash_panel {
    height: auto;
    max-height: 6;
    border: round grey;
}
