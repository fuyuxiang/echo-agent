/* echo_agent/cli/tui/app.tcss — three-zone layout: transcript fills, input
   row docks with auto height and divider lines, status bar pinned to bottom. */
TranscriptView {
    height: 1fr;
}

/* Brand banner on the first screen: a rounded panel with breathing room. */
Banner {
    margin: 1 1 0 1;
    padding: 0 1;
    border: round $primary;
    color: $text;
}

/* User task title: a left accent bar in the brand hue marks where a turn
   begins. The full-row tinted background it used to also carry made the title
   the loudest thing on screen — heavier than the answer it introduces — so the
   fill is gone and bar + bold do the work. It keeps its own margin on BOTH
   sides (layout.py classifies "user" as self-spaced and as painting its own
   trailing gap), so the transcript adds no further blank line around it. */
UserTurn {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $accent;
    color: $text;
    text-style: bold;
}

/* The answer is the point of the screen. It carries the ● sigil in the brand hue
   (blocks.AgentReply) and a full-strength foreground; the trace lines below carry
   neither, and that gap in weight is what lets a long run of them recede instead
   of competing with the conclusion. Previously AgentReply and ToolCallBlock/
   CognitiveBlock were styled identically (padding only), so after a dozen tool
   lines the eye had nothing to land on — users reported being unable to tell what
   the focal point of the screen was. Blank lines between blocks are inserted by
   the transcript at group boundaries (see layout.lead_gap) — a uniform CSS margin
   spaced a run of ten trace lines as airily as the boundary between the trace run
   and the answer, and blocks rendering nothing still painted their gap. */
AgentReply {
    padding: 0 1;
    color: $text;
}

/* Tool/cognitive trace lines are interactive: click or focus + Enter/Space
   toggles their detail/diff view. A hover + focus cue makes that discoverable
   (they were previously togglable in code but had no input path).

   text-opacity rather than a fixed grey: it stays legible on both palettes and
   keeps the semantic colours inside the line — the ✓/✗ marks and error text stay
   themselves, just quieter. Hover and focus restore full strength, since a user
   pointing at a line is deliberately reading it. */
ToolCallBlock, CognitiveBlock {
    padding: 0 1;
    text-opacity: 78%;
}

ToolCallBlock:hover, CognitiveBlock:hover {
    background: $boost;
    text-opacity: 100%;
}

ToolCallBlock:focus, CognitiveBlock:focus {
    background: $boost;
    border-left: thick $accent;
    padding-left: 0;
    text-opacity: 100%;
}

/* Live progress row, between transcript and input. It is NOT docked: the
   transcript above takes 1fr, so in normal flow this lands exactly above the
   input row while StatusBar keeps the bottom edge for itself (two dock:bottom
   widgets would compete for it, pushing the status bar up a row). Height 1 only
   while visible — the widget toggles `display`, and a display:none row
   contributes no height, so a screen that has not run anything yet ends at the
   last real content.

   It stays visible after a turn ends, holding a settled one-liner ("done · 12.4s
   · 3 tools"). That row IS the completion signal: hiding it took away the only
   moving thing on screen along with the elapsed clock, leaving "finished" and
   "hung" looking exactly alike. */
ActivityLine {
    height: 1;
    padding: 0 1;
    color: $text;
}

ApprovalBlock {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $warning;
    background: $boost;
}

ChoiceBlock {
    margin: 1 0;
    padding: 0 1;
    border-left: thick $secondary;
    background: $boost;
}

/* max-height covers the two border rows (top + bottom) on top of the text
   area, so it must be PromptInput's _MAX_ROWS + 2. At the old value of 10 the
   box grew to 10 text rows but only 8 were inside the frame, so from the 9th
   line on the user was typing into a line they could not see. */
#input_row {
    height: auto;
    max-height: 12;
    min-height: 1;
    border-top: solid $primary;
    border-bottom: solid $primary;
    layers: base hint;
}

#prompt_sigil {
    width: 2;
    color: $accent;
    text-style: bold;
}

PromptInput {
    height: auto;
    border: none;
}

/* Disabled while a clarify/approval owns the keyboard: dim it so the user
   sees the prompt is inert and their number/arrow/y-n-a keys drive the
   pending prompt instead. textual does not dim disabled widgets on its own. */
PromptInput:disabled {
    color: $text-muted;
    text-opacity: 60%;
}

/* Placeholder overlays the input area (hint layer) instead of taking its own
   row, so the empty state no longer shows a stray caption line under the box.
   It is hidden on first keystroke (display toggled by ContentChanged). */
#placeholder {
    layer: hint;
    offset: 3 0;
    width: 1fr;
    height: 1;
    color: $text-muted;
}

StatusBar {
    height: 1;
    dock: bottom;
    background: $status-surface;
    color: $status-foreground;
}

#slash_panel {
    height: auto;
    max-height: 6;
    border: round $primary;
}
