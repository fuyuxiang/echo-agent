{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoAgent",
  "version": "0.3.11",
  "identifier": "com.echoagent.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm ide:prepare && pnpm office:build && pnpm dev",
    "beforeBuildCommand": "pnpm ide:prepare && pnpm office:build && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EchoAgent",
        "url": "/",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' asset: https://asset.localhost data: blob:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; frame-src data: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../vendor/echo-agent-build/LICENSE": "licenses/echo-agent-build-LICENSE",
      "../vendor/echo-agent-build/third_party/NOTICE": "licenses/echo-agent-build-THIRD-PARTY-NOTICE",
      "../vendor/theia-platform/LICENSE-EPL": "licenses/theia/LICENSE-EPL",
      "../vendor/theia-platform/LICENSE-GPL-2.0-ONLY-CLASSPATH-EXCEPTION": "licenses/theia/LICENSE-GPL-2.0-ONLY-CLASSPATH-EXCEPTION",
      "../vendor/theia-platform/NOTICE.md": "licenses/theia/NOTICE.md",
      "resources/theia/browser": "theia/browser",
      "resources/theia/node": "theia/node",
      "resources/office": "office"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFRjEzQTM3RTc0OTBERUMKUldUc0RVbm5OenJ4TGhzeHowcWVUUnJGMmREc1lNdlcwNTlESm5Bd05iYmRZZXZGMnFlV291MTUK",
      "endpoints": [
        "https://123.56.188.16:8787/desktop-updates/stable/{{target}}-{{arch}}.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
