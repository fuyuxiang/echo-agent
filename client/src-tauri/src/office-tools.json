{
  "tools": [
    {
      "name": "office_create",
      "description": "Create real docx/pdf/xlsx/pptx using the bundled local generator; do not install Python or converters. Use markdown for basic exports, workbook for formulas/charts, or slides for an exact slide count (include the cover in the list). outputPath is relative to the task workspace, or an absolute path inside it; always honor the user's output directory/name. Never overwrites existing files. Reuse requestId for retries. Returns a verified file receipt, not proof of factual correctness. Formulas: arithmetic, comparisons, SUM/AVERAGE/MIN/MAX/COUNT/ROUND/IF/IFERROR, local/cross-sheet references. No external workbooks.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "format": {
            "type": "string",
            "enum": [
              "docx",
              "pdf",
              "xlsx",
              "pptx"
            ]
          },
          "markdown": {
            "type": "string",
            "maxLength": 2097152
          },
          "outputPath": {
            "type": "string",
            "maxLength": 4096
          },
          "requestId": {
            "type": "string",
            "maxLength": 128
          },
          "workbook": {
            "type": "object",
            "required": [
              "sheets"
            ],
            "properties": {
              "sheets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 30,
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "rows"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 31
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "anyOf": [
                            {
                              "type": [
                                "string",
                                "number",
                                "boolean",
                                "null"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "formula": {
                                  "type": "string"
                                },
                                "type": {
                                  "enum": [
                                    "text",
                                    "date"
                                  ]
                                },
                                "value": {
                                  "type": "string"
                                },
                                "format": {
                                  "type": "string"
                                }
                              }
                            }
                          ]
                        }
                      }
                    },
                    "widths": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 4,
                        "maximum": 100
                      }
                    },
                    "formats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "charts": {
                      "type": "array",
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "required": [
                          "type",
                          "categories",
                          "series"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "bar",
                              "line"
                            ]
                          },
                          "title": {
                            "type": "string"
                          },
                          "categories": {
                            "type": "string",
                            "description": "Single row/column range, e.g. A2:A7"
                          },
                          "position": {
                            "type": "string",
                            "description": "Top-left cell, e.g. H2"
                          },
                          "series": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "name",
                                "values"
                              ],
                              "properties": {
                                "name": {
                                  "type": "string"
                                },
                                "values": {
                                  "type": "string",
                                  "description": "Numeric range, e.g. B2:B7"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "slides": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 50
                },
                "body": {
                  "type": "string",
                  "description": "At most 700 characters, or 180 with a table/chart"
                },
                "table": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "maxLength": 90
                    }
                  }
                },
                "chart": {
                  "type": "object",
                  "required": [
                    "type",
                    "categories",
                    "series"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "bar",
                        "line"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "categories": {
                      "type": "array",
                      "maxItems": 40,
                      "items": {
                        "type": "string"
                      }
                    },
                    "series": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "object",
                        "required": [
                          "name",
                          "values"
                        ],
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "values": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "document": {
            "type": "object",
            "description": "Optional editable document JSON. Prefer markdown for initial creation. For revisions use office_document_read and office_document_update."
          }
        },
        "required": [
          "title",
          "format"
        ],
        "oneOf": [
          {
            "required": [
              "markdown"
            ]
          },
          {
            "required": [
              "workbook"
            ]
          },
          {
            "required": [
              "slides"
            ]
          }
        ]
      }
    },
    {
      "name": "office_document_read",
      "description": "Read the latest editable source and revision of a Word document in this task. Use this before editing a document opened in the document workspace. Preserve all unrequested structure and formatting. External documents must first be converted to an editable copy in the UI.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "office_document_update",
      "description": "Revise an existing editable Word document and regenerate its real DOCX. First call office_document_read. Supply the entire document JSON preserving unrequested nodes, marks and attrs, and the exact expectedRevision. On DOCUMENT_CONFLICT re-read and preserve newer manual edits. Never fall back to overwriting with shell commands. Returns a verified output receipt and revision.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "expectedRevision",
          "document"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 1
          },
          "document": {
            "type": "object",
            "description": "Tiptap document JSON from office_document_read, with requested changes. Supported nodes: doc, paragraph, heading (levels 1-3), text, hardBreak, bulletList, orderedList, listItem, blockquote, codeBlock, horizontalRule, table, tableRow, tableCell, tableHeader. Marks: bold, italic, underline, strike, code, link. Preserve table column counts; rowspan must be 1."
          }
        }
      }
    }
  ]
}
