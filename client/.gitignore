# EchoAgent project-local runtime state (memory, agents, skills, sessions)
/.echo-agent/
# Legacy runtime state may still exist during migration; never commit it.
/.g[r]ok/

# crates.io extraction marker and upstream-only GitHub workflows/templates.
/vendor/cpal-loopback/.cargo-ok
/vendor/cpal-loopback/.github/
/vendor/theia-platform/.github/

# Spare generated icons not used by the current macOS/Windows bundle.icon list.
# Keep the five configured PNG/ICO/ICNS inputs tracked.
/src-tauri/icons/64x64.png
/src-tauri/icons/Square107x107Logo.png
/src-tauri/icons/Square142x142Logo.png
/src-tauri/icons/Square150x150Logo.png
/src-tauri/icons/Square284x284Logo.png
/src-tauri/icons/Square30x30Logo.png
