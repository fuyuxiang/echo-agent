/src-tauri/icons/Square44x44Logo.png
/src-tauri/icons/Square71x71Logo.png
/src-tauri/icons/Square89x89Logo.png
/src-tauri/icons/StoreLogo.png
/src-tauri/icons/icon.png

# Rust / Tauri 构建产物与自动生成内容
/src-tauri/target/
/src-tauri/gen/
# 内嵌 Runtime 已由主仓库直接管理，仅忽略其本机构建产物。
/vendor/echo-agent-build/target/
/vendor/glib/target/
/vendor/glib/Cargo.lock
/vendor/lru-0.12/target/
/vendor/lru-0.12/Cargo.lock
/vendor/lru-0.16/target/
/vendor/lru-0.16/Cargo.lock
/vendor/theia-platform/**/lib/
/vendor/theia-platform/**/src-gen/
/vendor/theia-platform/.nx/
/vendor/theia-platform/.browser_modules/
/vendor/theia-platform/plugins/
/src-tauri/resources/theia/browser/*
!/src-tauri/resources/theia/browser/.keep
/src-tauri/resources/theia/node/*
!/src-tauri/resources/theia/node/.keep
/src-tauri/resources/theia/runtime-platform.json
/src-tauri/resources/office/worker.mjs
/src-tauri/resources/office/licenses/
/src-tauri/resources/retrieval-models/*
!/src-tauri/resources/retrieval-models/.keep
/src-tauri/resources/retrieval-models.lock/

# 本机环境与 Cargo 工具路径
.env
.env.*
!.env.example
/src-tauri/.cargo/config.toml
# Desktop updater signing keys must never enter source control.
**/echoagent.key
**/echoagent.key.pub

# 测试、覆盖率与编辑器缓存
.pytest_cache/
coverage/
.idea/
.vscode/

# 临时 CI 构建日志与安装包
/ci-artifacts/

# 规划与设计文档、SDD 工作文件不入库
.superpowers/
docs/superpowers/
.claude/

# 人工验收清单为本地工作文件, 不入库
docs/E2E-CHECKLIST.md

# 本机辅助脚本与内部工作文档
/scripts/_enum-windows.ps1
/scripts/_get-rect.ps1
/scripts/_record-echoagent.bat
/TODO.md
/ECHOAGENT_UI_REFERENCE.md

