{
  "private": true,
  "name": "@echoagent/theia-browser",
  "version": "1.74.0",
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "theia": {
    "generator": {
      "config": {
        "preloadTemplate": "./echo-locale-preload.html"
      }
    },
    "frontend": {
      "config": {
        "applicationName": "Echo Code",
        "defaultLocale": "zh-cn",
        "preferences": {
          "files.autoSave": "off",
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "window.menuBarVisibility": "compact"
        },
        "reloadOnReconnect": true
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": 3000,
        "configureProxyFromPreferences": true
      }
    }
  },
  "theiaPluginsDir": "../../plugins",
  "theiaPlugins": {
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix",
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.javascript": "https://open-vsx.org/api/vscode/javascript/1.95.3/file/vscode.javascript-1.95.3.vsix",
    "vscode.typescript": "https://open-vsx.org/api/vscode/typescript/1.95.3/file/vscode.typescript-1.95.3.vsix",
    "vscode.rust": "https://open-vsx.org/api/vscode/rust/1.95.3/file/vscode.rust-1.95.3.vsix",
    "vscode.python": "https://open-vsx.org/api/vscode/python/1.95.3/file/vscode.python-1.95.3.vsix",
    "vscode.java": "https://open-vsx.org/api/vscode/java/1.95.3/file/vscode.java-1.95.3.vsix",
    "vscode.json": "https://open-vsx.org/api/vscode/json/1.95.3/file/vscode.json-1.95.3.vsix",
    "vscode.yaml": "https://open-vsx.org/api/vscode/yaml/1.95.3/file/vscode.yaml-1.95.3.vsix",
    "vscode.html": "https://open-vsx.org/api/vscode/html/1.95.3/file/vscode.html-1.95.3.vsix",
    "vscode.css": "https://open-vsx.org/api/vscode/css/1.95.3/file/vscode.css-1.95.3.vsix",
    "vscode.markdown": "https://open-vsx.org/api/vscode/markdown/1.95.3/file/vscode.markdown-1.95.3.vsix",
    "vscode.shellscript": "https://open-vsx.org/api/vscode/shellscript/1.95.3/file/vscode.shellscript-1.95.3.vsix"
  },
  "dependencies": {
    "@echoagent/theia-bridge": "1.74.0",
    "@theia/bulk-edit": "1.74.0",
    "@theia/callhierarchy": "1.74.0",
    "@theia/console": "1.74.0",
    "@theia/core": "1.74.0",
    "@theia/debug": "1.74.0",
    "@theia/editor": "1.74.0",
    "@theia/editor-preview": "1.74.0",
    "@theia/file-search": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/keymaps": "1.74.0",
    "@theia/markers": "1.74.0",
    "@theia/messages": "1.74.0",
    "@theia/mini-browser": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/outline-view": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/plugin-ext": "1.74.0",
    "@theia/plugin-ext-vscode": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/property-view": "1.74.0",
    "@theia/scm": "1.74.0",
    "@theia/scm-extra": "1.74.0",
    "@theia/search-in-workspace": "1.74.0",
    "@theia/task": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/terminal-manager": "1.74.0",
    "@theia/timeline": "1.74.0",
    "@theia/toolbar": "1.74.0",
    "@theia/typehierarchy": "1.74.0",
    "@theia/userstorage": "1.74.0",
    "@theia/variable-resolver": "1.74.0",
    "@theia/vsx-registry": "1.74.0",
    "@theia/workspace": "1.74.0"
  },
  "scripts": {
    "clean": "theiaext clean",
    "download:plugins": "theia download:plugins",
    "build": "theiaext build && npm run -s bundle",
    "build:production": "theiaext build && npm run -s bundle:production",
    "bundle": "npm run rebuild && theia build --mode development",
    "bundle:production": "npm run rebuild && theia build --mode production",
    "compile": "tsc -b",
    "coverage": "npm run -s test -- --test-coverage && npm run -s coverage:report",
    "coverage:clean": "rimraf .nyc_output && rimraf coverage",
    "coverage:report": "nyc report --reporter=html",
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "start:plugins": "theia start --plugins=local-dir:../../plugins --ovsx-router-config=../ovsx-router-config.json",
    "start": "npm run -s start:plugins -- --log-config=log-config.json",
    "start:debug": "npm run -s start:plugins -- --log-level=debug",
    "start:watch": "concurrently --kill-others -n tsc,bundle,run -c red,yellow,green \"tsc -b -w --preserveWatchOutput\" \"npm run -s watch:bundle\" \"npm run -s start\"",
    "test": "theia test . --plugins=local-dir:../../plugins --test-spec=../api-tests/**/*.spec.js",
    "test:debug": "npm run -s test -- --test-inspect",
    "watch": "concurrently --kill-others -n tsc,bundle -c red,yellow \"tsc -b -w --preserveWatchOutput\" \"npm run -s watch:bundle\"",
    "watch:bundle": "theia build --watch --mode development",
    "watch:compile": "tsc -b -w"
  },
  "devDependencies": {
    "@theia/cli": "1.74.0"
  }
}
